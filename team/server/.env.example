# AI Learning Plan - Environment Configuration
# Salin file ini menjadi .env dan isi dengan nilai Anda.
# JANGAN commit file .env ke repository.

DATABASE_URL=postgres://user:pass@localhost:5432/planner
JWT_SECRET=changeme_minimal_32_karakter_random
JWT_REFRESH_SECRET=changeme_juga_minimal_32_karakter_random

# LLM Provider: "mock", "gemini", or "ollama"
#   mock - mengembalikan template tasks statis, cocok untuk development
#   gemini - menggunakan Google Gemini API, membutuhkan GEMINI_API_KEY valid
#   ollama - menggunakan Ollama lokal, membutuhkan OLLAMA_BASE_URL
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=1200

# Optional production fallbacks when the primary provider is slow or unavailable
GEMINI_PAID_API_KEY=
GEMINI_PAID_MODEL=gemini-3.1-flash-lite
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash
GLM_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Local LLM (fallback when LLM_PROVIDER=gemini, or primary when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

FIREBASE_SERVICE_ACCOUNT='{
  "type": "service_account",
  "project_id": "your_project_id",
  "private_key_id": "your_private_key_id",
  "private_key": "PASTE_ESCAPED_FIREBASE_PRIVATE_KEY_HERE",
  "client_email": "firebase-adminsdk@your_project.iam.gserviceaccount.com",
  "client_id": "your_client_id",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk@your_project.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"
}'

REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Production example
# NODE_ENV=production
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# REDIS_URL=redis://default:password@your-render-redis:6379

# Email delivery (OTP login + password reset)
# EMAIL_PROVIDER selects the adapter in email.service.js. Only "smtp" exists today.
# Swapping providers = change SMTP_HOST/SMTP_USER/SMTP_PASS (+ verify MAIL_FROM in the
# provider dashboard). No code change. Every cost-friendly provider exposes an SMTP relay:
#   Brevo      smtp-relay.brevo.com:587   ~300 emails/day free
#   Resend     smtp.resend.com:587        ~3k emails/month free
#   SendGrid   smtp.sendgrid.net:587      ~100 emails/day free
#   SMTP2GO    mail.smtp2go.com:587       small free daily quota
#   Amazon SES email-smtp.<region>.amazonaws.com:587  ~$0.10/1k (needs card)
# Without SMTP_HOST, OTPs fall back to the server console (development only).
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StepUp <no-reply@stepup.local>"

# Phone verification (Twilio) — paid, kept dormant. Endpoints return 404 unless
# PHONE_VERIFY_ENABLED=true. With a non-empty PHONE_VERIFY_WHITELIST, only those
# emails may use it. Unrelated to OTP login (which is email-only).
PHONE_VERIFY_ENABLED=false
PHONE_VERIFY_WHITELIST=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP policy (shared by password reset + login)
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_SESSION_TTL_MINUTES=15
OTP_HASH_SECRET=
